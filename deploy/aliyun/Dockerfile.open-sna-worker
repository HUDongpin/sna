FROM node:24.15.0-bookworm-slim AS base

ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="SNA worker" \
      org.opencontainers.image.description="SNA.HK Open SNA analysis worker for the primary Aliyun deployment." \
      org.opencontainers.image.source="https://github.com/HUDongpin/sna" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="UNLICENSED"

ENV NODE_ENV=production
ENV R_VERSION=4.4.2
# R 4.4.2 is the pinned runtime for Open SNA worker builds.

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin appuser

WORKDIR /app

FROM base AS deps

COPY package.json package-lock.json renv.lock ./
RUN npm ci

FROM deps AS verify

COPY . .
RUN Rscript --vanilla analysis/open-sna/preflight.R
RUN Rscript --vanilla analysis/open-sna/tests/conditioning-regression.R
RUN Rscript --vanilla analysis/open-sna/tests/group-selection-regression.R

FROM base AS final

COPY --from=deps /app/node_modules ./node_modules
COPY --from=verify /app/analysis ./analysis
COPY --from=verify /app/app ./app
COPY --from=verify /app/lib ./lib
COPY --from=verify /app/public ./public

ENV PORT=3000
ENV OPEN_SNA_R_WORKER_MODE=1

USER 10001:10001

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:3000/api/open-sna/analyze',{method:'POST',headers:{Authorization:'Bearer healthcheck'}}).then(r => { if (r.status !== 401) throw new Error('expected 401'); }).catch(err => { console.error(err.message); process.exit(1); })"

CMD ["node", "server.js"]
