# syntax=docker/dockerfile:1.7

FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS web-build

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ENV OPEN_SNA_CONTAINER_BUILD=1

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build -- --webpack

FROM rocker/r-ver:4.4.2@sha256:df26749182af64d5263bf64149d51a427b476ed28c4e046997143be3f97fdd7c AS worker-base

ARG VCS_REF=unknown

LABEL org.opencontainers.image.title="SNA worker" \
      org.opencontainers.image.description="SNA.HK Open SNA analysis worker for the primary Aliyun deployment." \
      org.opencontainers.image.source="https://github.com/HUDongpin/sna" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="UNLICENSED"

ARG RENV_VERSION=1.1.8
ARG RENV_SHA256=141b3a77a9e405eb1b586db7bda43088825b955ceacc1a2de0322a4fcf78ae08

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
    ca-certificates \
    cmake \
    curl \
    g++ \
    gcc \
    gfortran \
    libblas-dev \
    libcurl4-openssl-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libfribidi-dev \
    libgit2-dev \
    libglpk-dev \
    libgsl-dev \
    libharfbuzz-dev \
    libicu-dev \
    libjpeg-dev \
    liblapack-dev \
    libnlopt-dev \
    libpng-dev \
    libssl-dev \
    libtiff5-dev \
    libxml2-dev \
    libxt-dev \
    make \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV R_LIBS_USER=/opt/open-sna/r-library
ENV RENV_CONFIG_CACHE_ENABLED=false

COPY analysis/open-sna/renv.lock ./analysis/open-sna/renv.lock
COPY analysis/open-sna/preflight.R ./analysis/open-sna/preflight.R

RUN mkdir -p "${R_LIBS_USER}" \
  && curl --fail --location --silent --show-error \
    "https://cloud.r-project.org/src/contrib/Archive/renv/renv_${RENV_VERSION}.tar.gz" \
    --output /tmp/renv.tar.gz \
  && echo "${RENV_SHA256}  /tmp/renv.tar.gz" | sha256sum --check --strict \
  && R CMD INSTALL /tmp/renv.tar.gz \
  && rm /tmp/renv.tar.gz \
  && Rscript --vanilla -e 'renv::restore(lockfile = "analysis/open-sna/renv.lock", library = Sys.getenv("R_LIBS_USER"), prompt = FALSE)'

FROM worker-base AS verify

COPY analysis/open-sna/tests/conditioning-regression.R ./analysis/open-sna/tests/conditioning-regression.R
COPY analysis/open-sna/tests/group-selection-regression.R ./analysis/open-sna/tests/group-selection-regression.R
COPY analysis/open-sna ./analysis/open-sna

RUN Rscript --vanilla analysis/open-sna/preflight.R \
  && Rscript --vanilla analysis/open-sna/verify-conditioning.R \
  && Rscript --vanilla analysis/open-sna/verify-group-selection.R

FROM worker-base AS final

COPY --from=web-build /usr/local/bin/node /usr/local/bin/node
COPY --from=web-build /app/.next/standalone ./
COPY --from=web-build /app/.next/static ./.next/static
COPY --from=web-build /app/public ./public
COPY analysis/open-sna/analyze.R ./analysis/open-sna/analyze.R
COPY analysis/open-sna/preflight.R ./analysis/open-sna/preflight.R
COPY analysis/open-sna/analyze.R ./analysis/analyze.R
COPY analysis/open-sna/preflight.R ./analysis/preflight.R

RUN groupadd --gid 10001 open-sna \
  && useradd --uid 10001 --gid open-sna --create-home --shell /usr/sbin/nologin open-sna \
  && mkdir -p /tmp/open-sna-jobs \
  && chown -R open-sna:open-sna /app /tmp/open-sna-jobs

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV OPEN_SNA_R_WORKER_MODE=1
ENV OPEN_SNA_R_LIBS_USER=/opt/open-sna/r-library
ENV OPEN_SNA_R_WORKER_TMP_ROOT=/tmp/open-sna-jobs
ENV PORT=3000

USER open-sna
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD ["node", "-e", "const port=process.env.PORT||'3000';fetch('http://127.0.0.1:'+port+'/api/open-sna/analyze',{method:'POST'}).then(r=>{if(r.status!==401)process.exit(1)}).catch(()=>process.exit(1))"]

CMD ["sh", "-c", "Rscript --vanilla analysis/preflight.R && exec node server.js"]
