NEXT_PUBLIC_SITE_URL=https://www.sna.hk

# Required together for production workbook analysis. Non-loopback URLs must use HTTPS.
# Vercel uploads fail closed when either value is missing or invalid.
OPEN_SNA_R_API_URL=
OPEN_SNA_R_API_TOKEN=

# Dedicated R worker container settings. The worker refuses unauthenticated
# requests and requires a token of at least 32 characters.
OPEN_SNA_R_WORKER_MODE=0
OPEN_SNA_R_WORKER_TOKEN=
# Leave empty locally for an isolated execution directory; the container sets /tmp/open-sna-jobs.
OPEN_SNA_R_WORKER_TMP_ROOT=

# Local R adapter settings. Defaults to <project>/tmp/open-sna-jobs.
# OPEN_SNA_TMP_ROOT overrides must remain within the current project's tmp directory.
OPEN_SNA_RSCRIPT_BIN=Rscript
OPEN_SNA_R_LIBS_USER=
OPEN_SNA_TMP_ROOT=

# Optional local-only labels for workbooks where Gender is coded as 1 and 2.
# Set both together only after the dataset owner confirms the coding.
OPEN_SNA_GENDER_1_LABEL=
OPEN_SNA_GENDER_2_LABEL=

# Server-only OpenRouter credential for the Open SNA AI Interpretation panel.
# The model is pinned in code to openai/gpt-5.6-luna. Never use NEXT_PUBLIC_ here.
OPENROUTER_API_KEY=

# Durable local analysis: the web server and separate worker load the same .env.local.
# Run npm run open-sna:worker in a second terminal. Default root: <project>/tmp/open-sna-durable.
OPEN_SNA_JOB_STORE=filesystem
OPEN_SNA_JOB_ROOT=

# Dedicated production worker only. Set OPEN_SNA_JOB_STORE=gcs in that environment.
# Vercel keeps only OPEN_SNA_R_API_URL/TOKEN; it must not receive Google credentials.
OPEN_SNA_GCS_BUCKET=
GOOGLE_CLOUD_PROJECT=
OPEN_SNA_TASKS_LOCATION=asia-east2
OPEN_SNA_TASKS_QUEUE=
OPEN_SNA_TASKS_SERVICE_ACCOUNT=
OPEN_SNA_WORKER_ORIGIN=
OPEN_SNA_TASKS_AUDIENCE=
