NEXT_PUBLIC_SITE_URL=https://www.sna.hk

# Required together for production workbook analysis. Non-loopback URLs must use HTTPS.
# Vercel uploads fail closed when either value is missing or invalid.
OPEN_SNA_R_API_URL=
OPEN_SNA_R_API_TOKEN=

# Dedicated R worker container settings. The worker refuses unauthenticated
# requests and requires a token of at least 32 characters.
OPEN_SNA_R_WORKER_MODE=0
OPEN_SNA_R_WORKER_TOKEN=
OPEN_SNA_R_WORKER_TMP_ROOT=/tmp/open-sna-jobs

# Local R adapter settings. Keep the temporary root on /Volumes/Starship/.
OPEN_SNA_RSCRIPT_BIN=Rscript
OPEN_SNA_R_LIBS_USER=
OPEN_SNA_TMP_ROOT=

# Optional local-only labels for workbooks where Gender is coded as 1 and 2.
# Set both together only after the dataset owner confirms the coding.
OPEN_SNA_GENDER_1_LABEL=
OPEN_SNA_GENDER_2_LABEL=

# Server-only OpenRouter credential for the Open SNA AI Interpretation panel.
# The model is pinned in code to openai/gpt-5.6-luna. Never use NEXT_PUBLIC_ here.
OPENROUTER_API_KEY=
