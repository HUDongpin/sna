{
  "name": "sna",
  "version": "0.1.0",
  "private": true,
  "description": "Social Network Analysis Hong Kong",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "open-sna:r-preflight": "Rscript --vanilla analysis/open-sna/preflight.R",
    "open-sna:r-regression": "Rscript --vanilla analysis/open-sna/tests/empty-network-regression.R",
    "open-sna:r-group-regression": "Rscript --vanilla analysis/open-sna/tests/group-selection-regression.R",
    "open-sna:r-conditioning-regression": "Rscript --vanilla analysis/open-sna/tests/conditioning-regression.R",
    "open-sna:r-validation-runtime-isolation-regression": "Rscript --vanilla analysis/open-sna/tests/validation-runtime-isolation-regression.R",
    "open-sna:r-validation-cli-regression": "Rscript --vanilla analysis/open-sna/tests/validation-cli-regression.R",
    "open-sna:r-statistical-release": "npm run open-sna:r-preflight && npm run open-sna:r-validation-runtime-isolation-regression && npm run open-sna:r-validation-cli-regression && npm run open-sna:r-group-regression && npm run open-sna:r-conditioning-regression && npm run open-sna:r-regression",
    "release:hygiene": "node scripts/check-release.mjs",
    "release:verify": "npm run open-sna:r-statistical-release && npm run test && npm run build -- --webpack && npm run typecheck && npm run release:hygiene"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "next": "^16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "10.4.22",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.17",
    "tsx": "4.22.4",
    "typescript": "5.8.3"
  }
}
